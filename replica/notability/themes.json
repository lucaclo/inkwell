{
  "_about": "Adapted from replica-entrepreneur/themes.json for handwritten note-taking apps (Notability study for Inkwell). Python regexes, case-insensitive.",
  "request_patterns": [
    "\\bi wish\\b", "\\bplease (add|bring|make|fix|give)\\b", "\\bwould be (nice|great|good|helpful|amazing)\\b", "\\bwould love\\b",
    "\\bno way to\\b", "\\bthere'?s no (way|option)\\b",
    "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|undo|delete|turn off|scroll|search|find|move|select)\\b",
    "\\b(missing|lacks|lacking)\\b", "\\bdoesn'?t (have|support|let|allow)\\b", "\\bif only\\b", "\\bfeature request\\b", "\\bwhy (can'?t|isn'?t|doesn'?t)\\b", "\\bneeds? (a|an|the|to|more)\\b"
  ],
  "themes": [
    {"id": "dataloss", "label": "Lost or vanished notes", "kind": "complaint",
     "patterns": ["\\blost (my|all|every|years|hundreds|months|weeks|the|a)\\b", "\\bdisappear", "\\bvanish", "\\bdata loss\\b", "\\bwiped\\b", "\\bgone\\b", "\\bdeleted (all|my)\\b", "\\bmissing notes?\\b", "\\bnotes? (are|were) missing\\b", "\\blose (my|all)\\b", "\\blosing (my|all)\\b"]},
    {"id": "sync", "label": "Sync and the move to their own cloud", "kind": "complaint",
     "patterns": ["\\bsync", "\\bnotability cloud\\b", "\\bicloud\\b", "\\bmigrat", "\\bbackup\\b", "\\bback ?up\\b", "\\bduplicat", "\\bserver"]},
    {"id": "pricing", "label": "Subscription, paywall, note limit", "kind": "complaint",
     "patterns": ["\\bsubscri", "\\bpaywall", "\\bpay(ing|ed)? (for|to|monthly|yearly|again)\\b", "\\bexpensive\\b", "\\boverpriced\\b", "\\bpric(e|es|ey|ing)\\b", "\\bfree (version|plan|tier|notes?)\\b", "\\b(5|five) (free )?notes\\b", "\\bpremium\\b", "\\bnot worth\\b", "\\bmoney\\b", "\\bclassic\\b", "\\bone.?time\\b", "\\bgrandfather", "\\blifetime\\b", "\\bplus\\b", "\\bpro plan\\b"]},
    {"id": "billing", "label": "Billing, refunds, charged twice", "kind": "complaint",
     "patterns": ["\\bcharged\\b", "\\brefund", "\\bauto.?renew", "\\bbilling\\b", "\\bscam", "\\bstole"]},
    {"id": "bugs", "label": "Bugs, crashes, glitches", "kind": "complaint",
     "patterns": ["\\bcrash", "\\bbugs?\\b", "\\bbuggy\\b", "\\bglitch", "\\bfreez", "\\bbroken\\b", "\\b(doesn'?t|does not|stopped|won'?t) (work|open|load)", "\\bnot working\\b", "\\berror\\b"]},
    {"id": "performance", "label": "Slow, laggy, heavy", "kind": "complaint",
     "patterns": ["\\bslow", "\\blag", "\\bloading\\b", "\\btakes forever\\b", "\\bbattery\\b", "\\bsluggish\\b", "\\bmemory\\b", "\\bheavy\\b"]},
    {"id": "ink", "label": "Pen feel, ink, eraser, palm rejection", "kind": "complaint",
     "patterns": ["\\bink\\b", "\\bpen(s)?\\b", "\\bpencil\\b", "\\bstroke", "\\beraser\\b", "\\bpalm\\b", "\\bhandwriting\\b", "\\bwriting feel", "\\bsmooth"]},
    {"id": "ux", "label": "Clunky UI, redesign, bloat", "kind": "complaint",
     "patterns": ["\\bconfus", "\\bclunky\\b", "\\bcluttered\\b", "\\bunintuitive\\b", "\\bnot intuitive\\b", "\\bbloat", "\\bredesign", "\\bnew (update|version|design|ui|layout|interface)\\b", "\\bused to be\\b", "\\bbring back\\b", "\\bsince the (last |latest |new )?update\\b", "\\btoo many (steps|taps|clicks)\\b", "\\bhard to (use|find|navigate)\\b", "\\bcan'?t find\\b", "\\bliquid glass\\b", "\\btoolbar\\b"]},
    {"id": "ai", "label": "AI features pushed in", "kind": "complaint",
     "patterns": ["\\bai\\b", "\\bchat ?bot\\b", "\\bartificial intelligence\\b", "\\bsummar", "\\bflashcards?\\b", "\\bquiz"]},
    {"id": "support", "label": "Support that does not help", "kind": "complaint",
     "patterns": ["\\bcustomer (service|support)\\b", "\\bsupport\\b", "\\bno (response|reply)\\b", "\\bnever (replied|responded|heard back)\\b", "\\bemail(s|ed)? (them|support)\\b", "\\bfin\\b"]},
    {"id": "account", "label": "Forced login, account", "kind": "complaint",
     "patterns": ["\\blog ?(in|out)\\b", "\\bsign ?(in|up|out)\\b", "\\baccount\\b", "\\bpassword\\b", "\\blocked out\\b"]},
    {"id": "audio", "label": "Audio recording and transcription", "kind": "complaint",
     "patterns": ["\\baudio\\b", "\\brecord", "\\btranscri", "\\blecture recording"]},
    {"id": "pdf", "label": "PDF import, annotate, export", "kind": "request",
     "patterns": ["\\bpdfs?\\b", "\\bexport", "\\bimport", "\\bannotat", "\\bslides?\\b", "\\btextbook"]},
    {"id": "organisation", "label": "Folders, dividers, subjects, organisation", "kind": "request",
     "patterns": ["\\bfolders?\\b", "\\bsubfolder", "\\bdividers?\\b", "\\bsubjects?\\b", "\\borgani[sz]", "\\blibrary\\b", "\\btags?\\b"]},
    {"id": "search", "label": "Handwriting search and recognition", "kind": "request",
     "patterns": ["\\bsearch", "\\bocr\\b", "\\brecogni", "\\bconvert(ing)? (my )?handwriting\\b", "\\bmath conversion\\b"]},
    {"id": "scroll", "label": "Scrolling, pages, layout, split view", "kind": "request",
     "patterns": ["\\bscroll", "\\bsplit ?(view|screen)\\b", "\\bside.by.side\\b", "\\bmulti.?note\\b", "\\btabs?\\b", "\\bpages?\\b", "\\bzoom"]},
    {"id": "templates", "label": "Paper, templates, customisation", "kind": "request",
     "patterns": ["\\btemplates?\\b", "\\bpaper\\b", "\\bgrid\\b", "\\blined\\b", "\\bcustomi[sz]", "\\bcolou?rs?\\b", "\\bdark mode\\b", "\\bsettings?\\b"]},
    {"id": "platforms", "label": "Mac, iPhone, Android, web, offline", "kind": "request",
     "patterns": ["\\bmac\\b", "\\bmacbook\\b", "\\bmacos\\b", "\\bandroid\\b", "\\bwindows\\b", "\\boffline\\b", "\\bweb (app|version)\\b", "\\biphone\\b"]},
    {"id": "math", "label": "Maths, diagrams, shapes, layers", "kind": "request",
     "patterns": ["\\bmath", "\\bequation", "\\blatex\\b", "\\bdiagram", "\\bgraphs?\\b", "\\bshapes?\\b", "\\blayers?\\b", "\\bruler\\b", "\\blasso\\b"]}
  ]
}
